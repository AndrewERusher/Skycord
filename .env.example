# Skycord environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# TURN server for WebRTC calls. STUN alone cannot connect users behind
# strict NATs, so a TURN server is required for reliable calling.
# Free options: Metered (metered.ca), Cloudflare Calls, or self-hosted coturn.
VITE_TURN_URL=turn:your-turn-host:3478
VITE_TURN_USERNAME=your-username
VITE_TURN_CREDENTIAL=your-credential
